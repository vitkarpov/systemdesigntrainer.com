---
---

<section id="how-it-works" class="py-20 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">
        Practice Like It's Real
      </h2>
      <p class="text-lg text-slate-600 max-w-3xl mx-auto">
        Simulate real interview conditions with AI-powered feedback
      </p>
    </div>

    <!-- Steps -->
    <div class="space-y-20">
      <!-- Step 1: Start Interview -->
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white font-bold mb-4">
            1
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">
            Choose Your Interview Case
          </h3>
          <p class="text-lg text-slate-600 leading-relaxed mb-4">
            Select from curated system design cases based on real FAANG interviews. Each case is designed to test different aspects of system design.
          </p>
          <ul class="space-y-2 text-slate-600">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>URL shortener, social feed, video streaming, and more</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Real-world problems at different difficulty levels</span>
            </li>
          </ul>
        </div>
        <div class="order-1 lg:order-2">
          <div class="bg-white border border-slate-200 rounded-xl shadow-2xl p-4 aspect-video">
            <img
              src="/images/step-1-selection.png"
              alt="Case selection interface showing different system design interview cases"
              class="w-full h-full object-contain rounded-lg"
            />
          </div>
        </div>
      </div>

      <!-- Step 2: Face AI Interviewer -->
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="bg-white border border-slate-200 rounded-xl shadow-2xl p-4 aspect-video">
            <img
              src="/images/step-2-interview.png"
              alt="AI interview interface with chat, timer, and phase tracking"
              class="w-full h-full object-contain rounded-lg"
            />
          </div>
        </div>
        <div>
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white font-bold mb-4">
            2
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">
            Face the AI Interviewer
          </h3>
          <p class="text-lg text-slate-600 leading-relaxed mb-4">
            Experience a realistic 45-minute interview with phase-based progression. The AI interviewer asks follow-ups, applies pressure, and tracks your approach.
          </p>
          <ul class="space-y-2 text-slate-600">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Structured phases: Requirements → Design → Deep Dive</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Real-time signal tracking of your approach</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Visual timer with phase transitions</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Step 3: Get Feedback -->
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white font-bold mb-4">
            3
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">
            Get Detailed Feedback
          </h3>
          <p class="text-lg text-slate-600 leading-relaxed mb-4">
            Receive a comprehensive performance report with actionable insights. Know exactly what you missed and how to improve for your next interview.
          </p>
          <ul class="space-y-2 text-slate-600">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Overall score with detailed breakdown</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Specific areas for improvement</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Red flags identified during the interview</span>
            </li>
          </ul>
        </div>
        <div class="order-1 lg:order-2">
          <div class="bg-white border border-slate-200 rounded-xl shadow-2xl p-4 aspect-video">
            <img
              src="/images/step-3-interview.png"
              alt="Detailed feedback report with performance score and improvement areas"
              class="w-full h-full object-contain rounded-lg"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
