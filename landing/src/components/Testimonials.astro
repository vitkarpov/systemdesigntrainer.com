---
import { Card, CardContent } from './ui/Card';
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">
        Trusted by Engineers at Top Companies
      </h2>
      <p class="text-sm text-slate-600 italic">
        * Testimonials are illustrative examples. Real user testimonials coming soon.
      </p>
    </div>

    <!-- Testimonial Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Testimonial 1 -->
      <Card client:load className="bg-slate-50 border-slate-200">
        <CardContent client:load className="pt-6">
          <div class="flex items-start gap-1 mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-slate-600 mb-6 leading-relaxed">
            "This simulator helped me identify exactly where I was losing points in interviews. After 5 practice sessions, I aced my Meta interview."
          </p>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-white font-bold">
              AC
            </div>
            <div>
              <p class="font-semibold text-slate-900">Alex Chen</p>
              <p class="text-sm text-slate-600">Senior Engineer at Meta</p>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Testimonial 2 -->
      <Card client:load className="bg-slate-50 border-slate-200">
        <CardContent client:load className="pt-6">
          <div class="flex items-start gap-1 mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-slate-600 mb-6 leading-relaxed">
            "The AI interviewer applies real pressure. It's the closest thing to a real interview I've experienced. Worth every penny."
          </p>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center text-white font-bold">
              SJ
            </div>
            <div>
              <p class="font-semibold text-slate-900">Sarah Johnson</p>
              <p class="text-sm text-slate-600">Staff Engineer at Google</p>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Testimonial 3 -->
      <Card client:load className="bg-slate-50 border-slate-200">
        <CardContent client:load className="pt-6">
          <div class="flex items-start gap-1 mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-slate-600 mb-6 leading-relaxed">
            "I went from bombing every system design round to getting multiple offers. The structured feedback is a game-changer."
          </p>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-green-500 to-green-700 flex items-center justify-center text-white font-bold">
              MR
            </div>
            <div>
              <p class="font-semibold text-slate-900">Michael Rodriguez</p>
              <p class="text-sm text-slate-600">Senior Engineer at Amazon</p>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
