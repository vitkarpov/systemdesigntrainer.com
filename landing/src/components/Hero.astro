---
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-gradient-to-b from-slate-50 via-white to-slate-50">
  <!-- Background gradient blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mb-6">
          Master System Design Interviews
          <span class="block text-blue-600 mt-2">Before the Real One</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8 max-w-2xl mx-auto lg:mx-0">
          AI-powered interview simulations that feel real. Practice under pressure, get actionable feedback, and land your dream engineering role.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="https://app.systemdesigntrainer.com/login"
            class="inline-flex items-center justify-center h-14 px-10 text-lg font-bold rounded-xl bg-blue-600 text-white shadow-lg hover:bg-blue-700 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
          >
            Start Free Interview
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center h-14 px-10 text-lg font-bold rounded-xl border-2 border-blue-600 text-blue-600 bg-white shadow-sm hover:bg-blue-600 hover:text-white hover:shadow-md active:scale-[0.98] transition-all cursor-pointer"
          >
            See How It Works
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4 sm:gap-6 items-center justify-center lg:justify-start text-sm text-slate-600">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>No credit card required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>1 free interview included</span>
          </div>
        </div>
      </div>

      <!-- Hero Screenshot Placeholder -->
      <div class="relative">
        <div class="relative bg-white border border-slate-200 rounded-xl shadow-2xl overflow-hidden aspect-[4/3]">
          <!-- Placeholder for hero screenshot -->
          <div class="absolute inset-0 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
            <div class="text-center p-8">
              <div class="w-16 h-16 mx-auto mb-4 rounded-lg bg-blue-100 flex items-center justify-center">
                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
              </div>
              <p class="text-sm text-slate-600">Interview Interface Screenshot</p>
              <p class="text-xs text-slate-500 mt-1">Add screenshot: /landing/public/images/hero-screenshot.png</p>
            </div>
          </div>
          <!-- When you have the screenshot, replace the placeholder div above with:
          <img
            src="/images/hero-screenshot.png"
            alt="System design interview interface showing AI interviewer chat, timer, and requirements phase"
            class="w-full h-full object-cover"
          />
          -->
        </div>
      </div>
    </div>
  </div>
</section>
