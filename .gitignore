# Monorepo GitIgnore
# ===================
# This file contains ignore patterns for the entire monorepo
# covering both the NestJS backend and React/Vite frontend

# Dependencies
# ============
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
# =============
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
.next/
.nuxt/
.vuepress/dist/
api/public

# Backend specific (NestJS)
# =========================
api/dist/
api/coverage/
api/.nyc_output/

# Frontend specific (React/Vite)
# ==============================
app/dist/
app/dist-ssr/
app/coverage/
*.local

# Logs
# ====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
# ============
pids/
*.pid
*.seed
*.pid.lock

# Environment variables
# =====================
.env

# SOPS encryption keys (NEVER commit this!)
keys/

# Testing
# =======
coverage/
*/coverage/
.nyc_output/
.jest/
*.lcov
.coverage/

# Cache
# =====
.npm/
.yarn/
.pnpm/
.eslintcache/
.parcel-cache/
.cache/
.vite/
.rollup.cache/

# OS generated files
# ==================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories and files
# ============================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
# ===============
*.tmp
*.temp
.tmp/
.temp/

# Documentation
# =============
.docusaurus/

# Deployment
# ==========
.vercel/
.netlify/
.firebase/

*.gen.ts
app/src/api/openapi.json

terraform/terraform.tfvars
.terraform/
.terraform.lock.hcl
*tfstate*
*_accessKeys.csv