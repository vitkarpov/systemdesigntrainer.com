{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": true,
    "baseUrl": "./"
  },
  "include": [
    "lambda/**/*.ts",
    "db/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
