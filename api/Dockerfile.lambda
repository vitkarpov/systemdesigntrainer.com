# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including devDependencies for build)
RUN npm ci && \
    npm cache clean --force

# Copy source code
COPY . .

# Build the application (NestJS API - not needed for lambda, but includes db types)
RUN npm run build

# Build the lambda separately (now in /lambda instead of /src/lambda)
RUN npx tsc --project tsconfig.lambda.json

# Lambda runtime stage
FROM public.ecr.aws/lambda/nodejs:20

# Set working directory explicitly
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy Lambda-specific package files (minimal dependencies)
COPY lambda/package.json ./

# Install production dependencies only
# This installs only: drizzle-orm, pg, @aws-sdk/client-secrets-manager, bull, ioredis
RUN npm install --production && \
    npm cache clean --force

# Copy built application from builder
COPY --from=builder /app/dist/lambda ./lambda
COPY --from=builder /app/dist/db ./db

# Set the Lambda handler
# AWS Lambda will call: lambda/handler.handler
CMD [ "lambda/handler.handler" ]
