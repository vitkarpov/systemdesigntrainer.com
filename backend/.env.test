# Test Environment Configuration
NODE_ENV=test

# Test Database Configuration
# Uses separate database to avoid polluting dev data
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sd_sim_test
TEST_DB_NAME=sd_sim_test

# Test Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sd_sim_test

# Application
PORT=3000
FRONTEND_URL=http://localhost:5173

# JWT Configuration (test key - not production)
JWT_SECRET=test-jwt-secret-key-for-testing-only

# External services (mocked in tests)
ANTHROPIC_API_KEY=test_anthropic_key
WORKOS_CLIENT_ID=test_workos_client
WORKOS_API_KEY=test_workos_api_key
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
