# Test Environment Configuration
NODE_ENV=test

# Test Database Configuration
# Uses separate database to avoid polluting dev data
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sd_sim_test
TEST_DB_NAME=sd_sim_test

# Test Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sd_sim_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
PORT=3000
FRONTEND_URL=http://localhost:5173

# JWT Configuration (test key - not production)
JWT_SECRET=test-jwt-secret-key-for-testing-only

# External services (mocked in tests)
ANTHROPIC_API_KEY=test_anthropic_key
WORKOS_CLIENT_ID=test_workos_client
WORKOS_API_KEY=test_workos_api_key
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Stripe Configuration (test keys)
STRIPE_SECRET_KEY=sk_test_test_key_for_e2e_tests
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret_for_e2e_tests

# Stripe Price IDs (test values)
STRIPE_PRICE_3_INTERVIEWS=price_test_3_interviews
STRIPE_PRICE_5_INTERVIEWS=price_test_5_interviews
STRIPE_PRICE_UNLIMITED=price_test_unlimited
