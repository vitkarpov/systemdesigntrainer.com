  "info": {
    "title": "System Design Interview Simulator API",
    "description": "API for the SD Interview Simulator application",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "subscriptionStatus": {
            "type": "string"
          },
          "interviewsCompleted": {
            "type": "number"
          },
          "interviewsRemaining": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "avatarUrl",
          "subscriptionStatus",
          "interviewsCompleted",
          "interviewsRemaining"
        ]
      },
      "CreateSessionDto": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "number",
            "description": "Interview case ID",
            "example": 1
          },
          "companyStyle": {
            "type": "string",
            "description": "Company interview style",
            "enum": [
              "faang",
              "startup",
              "generic"
            ],
            "default": "generic"
          },
          "level": {
            "type": "string",
            "description": "Interview level",
            "enum": [
              "mid",
              "senior",
              "staff"
            ],
            "default": "mid"
          }
        },
        "required": [
          "caseId"
        ]
      },
      "InterviewCaseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "difficulty"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "userId": {
            "type": "number"
          },
          "caseId": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "completed",
              "abandoned"
            ]
          },
          "startedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "completedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "currentPhase": {
            "type": "string",
            "enum": [
              "problem",
              "requirements",
              "high_level",
              "deep_dive",
              "bottlenecks",
              "wrap_up"
            ]
          },
          "phaseStartedAt": {
            "format": "date-time",
            "type": "string"
          },
          "companyStyle": {
            "type": "string",
            "enum": [
              "faang",
              "startup",
              "generic"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "mid",
              "senior",
              "staff"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "interviewCase": {
            "$ref": "#/components/schemas/InterviewCaseDto"
          }
        },
        "required": [
          "id",
          "userId",
          "caseId",
          "status",
          "startedAt",
          "completedAt",
          "currentPhase",
          "phaseStartedAt",
          "companyStyle",
          "level",
          "createdAt",
          "updatedAt"
        ]
      },
      "PhaseMetadataDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Phase display name"
          },
          "description": {
            "type": "string",
            "description": "Phase description"
          },
          "order": {
            "type": "number",
            "description": "Phase order (1-6)"
          }
        },
        "required": [
          "name",
          "description",
          "order"
        ]
      },
      "CreateSessionResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "default": true
          },
          "data": {
            "type": "object",
            "properties": {
              "session": {
                "$ref": "#/components/schemas/SessionResponseDto"
              },
              "phaseMetadata": {
                "$ref": "#/components/schemas/PhaseMetadataDto"
              },
              "progress": {
                "type": "number"
              }
            },
            "required": [
              "session",
              "phaseMetadata",
              "progress"
            ]
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "sessionId": {
            "type": "number"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "interviewer",
              "candidate"
            ]
          },
          "text": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "secondsElapsed": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sessionId",
          "role",
          "text",
          "phase",
          "secondsElapsed",
          "createdAt"
        ]
      },
      "GetTranscriptResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "default": true
          },
          "data": {
            "type": "object",
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessageResponseDto"
                }
              },
              "count": {
                "type": "number"
              }
            },
            "required": [
              "messages",
              "count"
            ]
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "PhaseWithMetadataDto": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "problem",
              "requirements",
              "high_level",
              "deep_dive",
              "bottlenecks",
              "wrap_up"
            ],
            "description": "Phase identifier"
          },
          "metadata": {
            "description": "Phase display information",
            "allOf": [
              {
                "$ref": "#/components/schemas/PhaseMetadataDto"
              }
            ]
          },
          "isCurrent": {
            "type": "boolean",
            "description": "Whether this is the current phase"
          },
          "progress": {
            "type": "number",
            "description": "Progress percentage (0-100)"
          }
        },
        "required": [
          "phase",
          "metadata",
          "isCurrent",
          "progress"
        ]
      },
      "GetPhasesResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "default": true
          },
          "data": {
            "type": "object",
            "properties": {
              "phases": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PhaseWithMetadataDto"
                }
              },
              "currentPhase": {
                "type": "string"
              }
            },
            "required": [
              "phases",
              "currentPhase"
            ]
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "GetSessionResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "default": true
          },
          "data": {
            "type": "object",
            "properties": {
              "session": {
                "$ref": "#/components/schemas/SessionResponseDto"
              },
              "elapsedSeconds": {
                "type": "number"
              },
              "phaseElapsedSeconds": {
                "type": "number"
              },
              "phaseMetadata": {
                "$ref": "#/components/schemas/PhaseMetadataDto"
              },
              "progress": {
                "type": "number"
              }
            },
            "required": [
              "session",
              "elapsedSeconds",
              "phaseElapsedSeconds",
              "phaseMetadata",
              "progress"
            ]
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "StartSessionResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "default": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "session": {
                "$ref": "#/components/schemas/SessionResponseDto"
              }
            },
            "required": [
              "session"
            ]
          }
        },
        "required": [
          "success",
          "message",
          "data"
        ]
      },
      "RedFlagResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "flagName": {
            "type": "string"
          },
          "detectedAt": {
