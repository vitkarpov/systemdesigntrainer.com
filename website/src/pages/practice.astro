---
import Layout from '../layouts/Layout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="System Design Interview Practice - Master with AI-Powered Simulations"
  description="Practice system design interviews with our AI-powered simulator. Get real-time feedback, master key concepts like scalability and load balancing, and ace your FAANG interviews."
>
  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-gradient-to-b from-blue-50 via-white to-slate-50">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mb-6">
            System Design Interview Practice
            <span class="block text-blue-600 mt-2">That Actually Prepares You</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8">
            Practice system design interviews with an AI interviewer that applies real pressure. Master concepts like scalability, load balancing, caching, and database sharding through realistic simulations.
          </p>

          <!-- Trust indicators -->
          <div class="flex flex-wrap gap-6 items-center justify-center text-sm text-slate-600 mb-12">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">Real interview pressure</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">Instant feedback</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">1 free interview</span>
            </div>
          </div>

          <!-- Interactive Demo -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">See How It Works</h2>
            <div style="position: relative; width: 100%; aspect-ratio: 1.93;">
              <!-- Loading Skeleton -->
              <div
                id="demo-loader"
                class="absolute inset-0 bg-white rounded-lg border border-gray-200 flex items-center justify-center"
                style="z-index: 10;"
              >
                <div class="text-center">
                  <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-gray-900 mb-4"></div>
                  <p class="text-lg font-medium text-gray-700">Loading interactive demo...</p>
                  <p class="text-sm text-gray-500 mt-2">This may take a moment</p>
                </div>
              </div>

              <iframe
                id="demo-iframe"
                src="https://app.supademo.com/embed/cmkbjcrqp2ohqke4xp77razgz?embed_v=2&utm_source=website&utm_medium=practice"
                loading="lazy"
                title="System Design Interview Practice Demo"
                allow="clipboard-write"
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 10px; opacity: 0; transition: opacity 0.3s ease-in-out;"
              />
            </div>
          </div>

          <script>
            document.getElementById('demo-iframe')?.addEventListener('load', function() {
              const loader = document.getElementById('demo-loader');
              const iframe = document.getElementById('demo-iframe');
              if (loader) loader.style.display = 'none';
              if (iframe) iframe.style.opacity = '1';
            });
          </script>

          <!-- CTA -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://app.systemdesigntrainer.com/login?utm_source=website&utm_medium=practice&utm_campaign=signup"
              class="inline-flex items-center justify-center h-14 px-10 text-lg font-bold rounded-xl bg-blue-600 text-white shadow-lg hover:bg-blue-700 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              Start Practicing Now
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Practice Matters Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            Why System Design Interview Practice Is Critical
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            System design interviews determine your level and compensation at top tech companies. Most candidates fail because they lack realistic practice.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-slate-50 rounded-xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Handle Time Pressure</h3>
            <p class="text-slate-600">
              Real interviews are timed and stressful. Practice under realistic conditions to build confidence and improve your performance when it counts.
            </p>
          </div>

          <div class="bg-slate-50 rounded-xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Master Core Concepts</h3>
            <p class="text-slate-600">
              Learn scalability, load balancing, caching strategies, database sharding, CAP theorem, and other essential patterns through hands-on practice.
            </p>
          </div>

          <div class="bg-slate-50 rounded-xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Get Actionable Feedback</h3>
            <p class="text-slate-600">
              Receive detailed feedback on your designs, communication style, and trade-off analysis. Improve with every practice session.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What You'll Practice Section -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            What You'll Practice
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Cover all essential system design topics through realistic interview scenarios
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { topic: 'Scalability & Load Balancing', desc: 'Design systems that handle millions of users' },
            { topic: 'Database Design', desc: 'Master SQL vs NoSQL, sharding, and replication' },
            { topic: 'Caching Strategies', desc: 'Implement Redis, CDNs, and cache invalidation' },
            { topic: 'Microservices Architecture', desc: 'Design distributed systems and service communication' },
            { topic: 'Message Queues', desc: 'Learn Kafka, RabbitMQ, and async processing' },
            { topic: 'API Design', desc: 'Create REST and GraphQL APIs that scale' }
          ].map((item) => (
            <div class="bg-white rounded-lg p-6 border border-slate-200">
              <h3 class="font-bold text-slate-900 mb-2">{item.topic}</h3>
              <p class="text-sm text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            Practice Like a Real Interview
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Start Your Session</h3>
            <p class="text-slate-600">
              Choose from common system design problems or get a random challenge
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Design Under Pressure</h3>
            <p class="text-slate-600">
              AI interviewer asks follow-up questions and challenges your assumptions
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Review & Improve</h3>
            <p class="text-slate-600">
              Get detailed feedback and track your progress over time
            </p>
          </div>
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</Layout>
