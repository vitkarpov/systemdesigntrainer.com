---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found - System Design Trainer"
  description="The page you're looking for doesn't exist."
>
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-white to-purple-50 px-4">
    <div class="text-center max-w-2xl mx-auto py-20">
      <h1 class="text-8xl font-bold text-gray-900 mb-4">404</h1>
      <h2 class="text-3xl font-semibold text-gray-800 mb-6">Page Not Found</h2>
      <p class="text-xl text-gray-600 mb-8">
        Looks like this page doesn't exist. Maybe it's practicing for a system design interview?
      </p>
      <div class="flex gap-4 justify-center">
        <a
          href="/"
          class="px-8 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
        >
          Go Home
        </a>
        <a
          href="/blog"
          class="px-8 py-3 bg-white text-blue-600 font-semibold rounded-lg border-2 border-blue-600 hover:bg-blue-50 transition-colors"
        >
          Read Blog
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
