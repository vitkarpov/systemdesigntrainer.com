<Layout
  title="System Design Interview Questions - Complete Resource Guide"
  description="Comprehensive collection of 20+ system design interview questions from FAANG companies. Includes approach strategies, key concepts, trade-offs, and practice tips for each question."
>
  <main class="min-h-screen bg-gradient-to-b from-slate-50 via-white to-slate-50">
    <!-- Navigation -->
    <nav class="border-b border-slate-200">
      <div class="max-w-5xl mx-auto px-4 py-4">
