---
import Layout from '../layouts/Layout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Mock System Design Interview - Practice with AI Interviewer"
  description="Experience realistic mock system design interviews with an AI interviewer. Get real-time feedback, practice under pressure, and prepare for FAANG interviews."
>
  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-gradient-to-b from-purple-50 via-white to-slate-50">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-0 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center max-w-4xl mx-auto">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mb-6">
            Mock System Design Interview
            <span class="block text-purple-600 mt-2">Experience Real Interview Conditions</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8">
            Practice with an AI interviewer that asks follow-up questions, challenges your decisions, and evaluates your design just like a real FAANG interviewer would.
          </p>

          <!-- Trust indicators -->
          <div class="flex flex-wrap gap-6 items-center justify-center text-sm text-slate-600 mb-12">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">45-60 minute sessions</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">Real-time questioning</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">Detailed feedback report</span>
            </div>
          </div>

          <!-- Interactive Demo -->
          <div class="mb-12">
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Watch a Mock Interview in Action</h2>
            <div style="position: relative; width: 100%; aspect-ratio: 1.93;">
              <!-- Loading Skeleton -->
              <div
                id="demo-loader"
                class="absolute inset-0 bg-white rounded-lg border border-gray-200 flex items-center justify-center"
                style="z-index: 10;"
              >
                <div class="text-center">
                  <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-gray-900 mb-4"></div>
                  <p class="text-lg font-medium text-gray-700">Loading interactive demo...</p>
                  <p class="text-sm text-gray-500 mt-2">This may take a moment</p>
                </div>
              </div>

              <iframe
                id="demo-iframe"
                src="https://app.supademo.com/embed/cmkbjcrqp2ohqke4xp77razgz?embed_v=2&utm_source=website&utm_medium=mock-interview"
                loading="lazy"
                title="Mock System Design Interview Demo"
                allow="clipboard-write"
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 10px; opacity: 0; transition: opacity 0.3s ease-in-out;"
              />
            </div>
          </div>

          <script>
            document.getElementById('demo-iframe')?.addEventListener('load', function() {
              const loader = document.getElementById('demo-loader');
              const iframe = document.getElementById('demo-iframe');
              if (loader) loader.style.display = 'none';
              if (iframe) iframe.style.opacity = '1';
            });
          </script>

          <!-- CTA -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://app.systemdesigntrainer.com/login?utm_source=website&utm_medium=mock-interview&utm_campaign=signup"
              class="inline-flex items-center justify-center h-14 px-10 text-lg font-bold rounded-xl bg-purple-600 text-white shadow-lg hover:bg-purple-700 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all"
            >
              Start Your Mock Interview
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">First interview is free - no credit card required</p>
        </div>
      </div>
    </section>

    <!-- Why Mock Interviews Matter Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            Why Mock Interviews Are Essential
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            The difference between passing and failing often comes down to interview experience and confidence under pressure.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h3 class="text-2xl font-bold text-slate-900 mb-6">Without Mock Interviews</h3>
            <div class="space-y-4">
              {[
                'Freeze under pressure during the real interview',
                'Struggle to articulate design decisions clearly',
                'Miss important clarifying questions',
                'Fail to handle curveball questions',
                'Don\'t know your weak areas until it\'s too late'
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  <p class="text-slate-700">{item}</p>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h3 class="text-2xl font-bold text-slate-900 mb-6">With Mock Interviews</h3>
            <div class="space-y-4">
              {[
                'Stay calm and confident during real interviews',
                'Communicate designs clearly and concisely',
                'Ask the right questions upfront',
                'Handle unexpected challenges smoothly',
                'Know exactly what to improve before the real thing'
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <p class="text-slate-700">{item}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What Makes Our Mock Interviews Different -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            What Makes Our Mock Interviews Different
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Most practice platforms give you static problems. We simulate the real interview experience.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Interactive AI Interviewer</h3>
            <p class="text-slate-600">
              Not just a static problem - our AI asks follow-up questions, digs into your decisions, and challenges your assumptions like a real interviewer.
            </p>
          </div>

          <div class="bg-white rounded-xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Real Time Pressure</h3>
            <p class="text-slate-600">
              Experience the same 45-60 minute time constraint as actual interviews. Learn to pace yourself and prioritize what matters most.
            </p>
          </div>

          <div class="bg-white rounded-xl p-8 border border-slate-200">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Comprehensive Feedback</h3>
            <p class="text-slate-600">
              Get detailed analysis of your design, communication, and decision-making. Know exactly what to improve before your real interview.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Common Questions Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            Practice Common Interview Questions
          </h2>
          <p class="text-lg text-slate-600 max-w-3xl mx-auto">
            Our mock interviews cover the most frequently asked system design problems
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {[
            'Design Instagram/Twitter - social media at scale',
            'Design YouTube/Netflix - video streaming platform',
            'Design Uber/Lyft - real-time location matching',
            'Design WhatsApp/Slack - messaging system',
            'Design TinyURL - URL shortening service',
            'Design Google Search - web crawler and indexer',
            'Design Amazon/eBay - e-commerce platform',
            'Design Dropbox/Google Drive - file storage system'
          ].map((item) => (
            <div class="bg-slate-50 rounded-lg p-6 border border-slate-200 flex items-center gap-4">
              <svg class="w-8 h-8 text-purple-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-slate-900 font-medium">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>
  <Footer />
</Layout>
