---
---

<section id="how-it-works" class="py-20 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Heading -->
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">
        See How It Works
      </h2>
      <p class="text-lg text-slate-600 max-w-3xl mx-auto">
        Experience a realistic system design interview simulation
      </p>
    </div>

    <!-- Interactive Demo -->
    <div class="relative mx-auto" style="max-width: 1200px;">
      <div style="position: relative; box-sizing: content-box; max-height: 80vh; width: 100%; aspect-ratio: 1.93; padding: 40px 0;">
        <div
          id="demo-loading"
          class="absolute inset-0 bg-white rounded-lg border border-slate-200 flex items-center justify-center"
          style="z-index: 10;"
        >
          <div class="text-center">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-slate-900 mb-4"></div>
            <p class="text-lg font-medium text-slate-700">Loading interactive demo...</p>
            <p class="text-sm text-slate-500 mt-2">This may take a moment</p>
          </div>
        </div>

        <iframe
          id="supademo-iframe"
          src="https://app.supademo.com/embed/cmkbjcrqp2ohqke4xp77razgz?embed_v=2&utm_source=embed"
          loading="lazy"
          title="Conduct a System Design Interview on System Design Trainer"
          allow="clipboard-write"
          style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.3s ease-in-out; border: 0; border-radius: 8px;"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const iframe = document.getElementById('supademo-iframe') as HTMLIFrameElement;
  const loading = document.getElementById('demo-loading');

  if (iframe && loading) {
    iframe.addEventListener('load', () => {
      loading.style.display = 'none';
      iframe.style.opacity = '1';
    });
  }
</script>
